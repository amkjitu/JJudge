# Copy to .env and adjust. docker compose reads .env automatically.
# Nothing here is a real secret - these are local development defaults.

# ---- PostgreSQL -----------------------------------------------------------------------
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena
POSTGRES_PORT=5432

# ---- arena-api ------------------------------------------------------------------------
ARENA_API_PORT=8080
ARENA_LOG_LEVEL=INFO
ARENA_DB_POOL_SIZE=10

# ---- Authentication --------------------------------------------------------------------
# HS256 signing key. At least 32 bytes; the application refuses to start without it.
# This one is a development placeholder - generate your own for anything reachable:
#   openssl rand -base64 48
ARENA_JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
ARENA_JWT_ISSUER=codearena
ARENA_JWT_ACCESS_TTL=15m
ARENA_JWT_REFRESH_TTL=7d

# Set to true wherever the app is served over TLS. Leave false for local HTTP, or the
# refresh cookie is never sent and login appears to silently fail.
ARENA_SECURE_COOKIES=false

# ---- Google OAuth2 (optional) -----------------------------------------------------------
# Leave both blank to disable Google login entirely - the app starts fine without them.
# Authorised redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ARENA_OAUTH2_SUCCESS_REDIRECT=/

# ---- Rate limiting ----------------------------------------------------------------------
ARENA_RATE_LIMIT_ENABLED=true
ARENA_RATE_LIMIT_SUBMISSIONS=10
ARENA_RATE_LIMIT_WINDOW=1m

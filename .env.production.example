# Production secrets and settings. Copy to `.env` on the server and fill in.
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# `.env` is gitignored. Nothing in this file is a working default - the compose overlay uses
# ${VAR:?message} for the ones that matter, so a missing secret stops the deploy instead of
# quietly weakening it.

# ---- Public identity --------------------------------------------------------------------
# Must already resolve to this machine's public IP before the first start: Caddy asks Let's
# Encrypt for a certificate on boot, and the HTTP-01 challenge fails if DNS is not in place.
ARENA_DOMAIN=arena.example.com
# Let's Encrypt sends expiry warnings here.
ARENA_TLS_EMAIL=you@example.com

# ---- Secrets ----------------------------------------------------------------------------
# Generate both, do not invent them by hand:
#
#   openssl rand -base64 48        # ARENA_JWT_SECRET
#   openssl rand -base64 24        # ARENA_ADMIN_PASSWORD
#
# The signing key. Changing it invalidates every issued access token, which is the correct
# response to a suspected leak.
ARENA_JWT_SECRET=

# Replaces the seeded admin password, which is printed in the README and grants problem CRUD.
# The application refuses to start without this, and rejects the published value. This is the
# single most important line in the file.
ARENA_ADMIN_PASSWORD=

# The database is not exposed publicly, but it is worth changing anyway: a compromise elsewhere
# on the box should not find the credentials written in a public repository.
POSTGRES_PASSWORD=

# ---- Demo behaviour ---------------------------------------------------------------------
# alice, bob and carol keep their README passwords so a visitor has something to sign in as.
# They are ordinary users - they can submit, and nothing else. Set true to close that too.
ARENA_LOCK_DEMO_USERS=false

# ---- Capacity ---------------------------------------------------------------------------
# Submissions per user per minute. Lower than the development default: judging is the expensive
# operation and a public form is a different threat model from a laptop.
ARENA_RATE_LIMIT_SUBMISSIONS=5

# One week of Kafka retention. Every partition lives on this single broker, so retention is the
# only thing between a busy week and a full disk.
KAFKA_RETENTION_HOURS=168
KAFKA_HEAP_OPTS=-Xmx512m -Xms256m

# ---- Optional: Google sign-in -------------------------------------------------------------
# Leave blank to disable. The authorised redirect URI in Google Cloud Console must be exactly
#   https://<ARENA_DOMAIN>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: a real language model -------------------------------------------------------
# Without this, arena-ai answers from its static analyser and labels every response HEURISTIC,
# which is a supported way to run. Point it at an Ollama instance to get model-backed answers -
# but note a useful model needs several GB of RAM on top of everything else here.
# ARENA_OLLAMA_URL=http://host.docker.internal:11434
# ARENA_OLLAMA_MODEL=llama3.2

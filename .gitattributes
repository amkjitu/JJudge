# Normalise line endings so the repo is identical on Windows, Linux and in Docker.
* text=auto eol=lf

# mvnw is executed by /bin/sh in CI and in the Docker build - CRLF would break the shebang.
mvnw text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

mvnw.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.jar binary

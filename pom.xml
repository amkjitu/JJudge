<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.codearena</groupId>
    <artifactId>codearena-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CodeArena</name>
    <description>Competitive programming practice platform</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <modules>
        <module>arena-common</module>
        <module>arena-api</module>
        <module>arena-judge</module>
        <module>arena-ai</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Testcontainers talks to the daemon through docker-java, which still negotiates
             Docker API 1.32 by default. Docker Engine 25+ advertises a minimum API of 1.40 and
             answers anything older with a bare HTTP 400, which surfaces as the thoroughly
             misleading "Could not find a valid Docker environment". docker-java reads this as a
             *system property* - the DOCKER_API_VERSION environment variable has no effect - so
             it has to be handed to the forked test JVM via argLine.
             1.41 is supported by every Docker Engine from 20.10 onwards. -->
        <docker.api.version>1.41</docker.api.version>
        <argLine>-Dapi.version=${docker.api.version}</argLine>

        <!-- WebJar versions. These also appear in the asset paths in fragments/layout.html,
             which is the one template that references them - bump both together. -->
        <bootstrap.version>5.3.3</bootstrap.version>
        <chartjs.version>4.4.3</chartjs.version>
        <codemirror.version>5.65.16</codemirror.version>

        <!--
          Output directory, parameterised so a command-line build can be told to use its own.

          The default is the usual `target`, which is what CI and the Dockerfiles expect. The
          escape hatch exists because an IDE running its own compiler over the same module -
          VS Code's Java extension, for one - writes Eclipse-compiled classes into `target` too,
          and a background rebuild can overwrite Maven's output mid-build. The result is a class
          file containing "Unresolved compilation problems" that fails at *runtime* with a
          baffling ClassNotFoundException for a class sitting right there on disk.

              ./mvnw -Darena.build.directory=target-cli verify
        -->
        <arena.build.directory>target</arena.build.directory>

        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>2.8.17</springdoc.version>
        <commonmark.version>0.30.0</commonmark.version>

        <!-- Spring AI has no GA release built against Boot 3.3.x - 1.0.0 targets 3.4.5 and the
             current line targets 3.5.x - which is what moved this project off 3.3.5. Keep this
             in step with the parent above when either is bumped. -->
        <spring-ai.version>1.0.9</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.codearena</groupId>
                <artifactId>arena-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Every module gets Lombok (compile-time only) and the standard test kit. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${project.basedir}/${arena.build.directory}</directory>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Amapstruct.defaultComponentModel=spring</arg>
                            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        </compilerArgs>
                        <!--
                          Recompile the whole module when anything in it changes. Maven's
                          "incremental" mode decides per file, which interacts badly with
                          annotation processors: MapStruct needs to see the interface to
                          regenerate its implementation, and a partial recompile can leave the
                          two out of step. Cheap insurance on a build this size.
                        -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
